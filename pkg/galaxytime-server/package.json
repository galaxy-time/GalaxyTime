{
  "name": "gt-server",
  "description": "galaxy time server",
  "version": "1.0.0",
  "packageManager": "yarn@1.22.21",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn install && yarn workspace api dev",
    "build": "yarn install && yarn workspaces foreach --topological-dev -Api run build",
    "docker": "yarn docker:build && yarn docker:run",
    "docker:build": "docker build . -t galaxytime/server:local",
    "docker:run": "docker run -it -p 3000:3000 -p 4000:4000 galaxytime/server:local yarn workspace api start",
    "format": "yarn workspaces foreach --topological-dev -Api run format",
    "lint": "yarn workspaces foreach --topological-dev -Api run lint",
    "test": "yarn workspaces foreach --topological-dev -Api run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@commitlint/cz-commitlint": "^18.4.3",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "pretty-quick": "^3.1.3"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "yarn lint-staged"
    }
  },
  "lint-staged": {
    "*": "yarn format:staged"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
