				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:contentDescription="@string/settings_change_color_style_button_content_description"
				android:gravity="center_horizontal|center_vertical"
				android:onClick="onClickColorStylePickerButton"
				android:padding="@dimen/no_padding"
				android:text="@string/settings_color_style_picker_label"
				android:textAppearance="?attr/textAppearanceButton"
				app:icon="@drawable/circle"
				app:iconPadding="@dimen/settings_style_picker_icon_padding" />

		</LinearLayout>

