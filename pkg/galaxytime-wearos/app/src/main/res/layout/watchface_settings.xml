<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"

	android:id="@+id/selector"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:animateLayoutChanges="true"
	android:background="@color/black"
	android:fillViewport="true"
	android:paddingStart="@dimen/settings_padding"
	android:paddingTop="@dimen/settings_padding"

	android:paddingEnd="@dimen/settings_padding"
	android:paddingBottom="@dimen/settings_padding"
	tools:context=".settings.WatchFaceSettingsActivity"
	tools:deviceIds="wear">

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/form_layout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:overScrollMode="ifContentScrolls"
		android:paddingStart="40sp"
		android:paddingTop="@dimen/settings_padding"
		android:paddingEnd="40sp"
		android:paddingBottom="@dimen/settings_padding"
		android:scrollbarStyle="insideOverlay"
		android:scrollbars="vertical"
		android:textAlignment="center">

		<include
			android:id="@+id/preview"
			layout="@layout/watchface_preview"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_horizontal|center_vertical"
			android:contentDescription="@string/settings_preview_of_watch_face_content_description"
			android:visibility="visible"
			app:layout_constraintTop_toTopOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintBottom_toTopOf="@+id/text_view"
			tools:layout_editor_absoluteX="12dp" />

		<TextView
			android:id="@+id/text_view"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_centerHorizontal="true"
			android:gravity="center_horizontal|center_vertical"
			android:paddingVertical="5sp"
			android:text="@string/colors_style_setting_description"
			android:textColor="@color/white"
			app:layout_constraintTop_toBottomOf="@+id/preview"
			tools:layout_editor_absoluteX="6dp" />

		<RadioGroup
			android:id="@+id/radio_group"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			app:layout_constraintTop_toBottomOf="@+id/text_view"
			tools:layout_editor_absoluteX="6dp">

			<RadioButton
				android:id="@+id/id_mercury"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:button="@drawable/mercury_style"
				android:paddingVertical="5sp"
				android:paddingStart="10sp"
				android:text="@string/mercury_style_name"
				android:textColor="#FFFFFF"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_venus"
				android:button="@drawable/venus_style"
				android:text="@string/venus_style_name"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_earth"
				android:button="@drawable/earth_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/earth_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_moon"
				android:button="@drawable/moon_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/moon_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_mars"
				android:button="@drawable/mars_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/mars_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_saturn"
				android:button="@drawable/saturn_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/saturn_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_jupiter"
				android:button="@drawable/jupiter_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/jupiter_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_uranus"
				android:button="@drawable/uranus_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/uranus_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_neptune"
				android:button="@drawable/neptune_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/neptune_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />
			<RadioButton
				android:id="@+id/id_pluto"
				android:button="@drawable/pluto_style"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="5sp"
				android:text="@string/pluto_style_name"
				android:textColor="#FFFFFF"
				android:paddingStart="10sp"
				android:textSize="12sp" />

			</RadioGroup>

	</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
